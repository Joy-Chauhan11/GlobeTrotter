# Server
PORT=3000

# PostgreSQL / Neon
# Paste your Neon connection string here.
# Get it from: Neon Dashboard → Your Project → Connection Details → Connection string
# It should look like: postgresql://username:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DB?sslmode=require"
